---
import type { MetadataProps as Props, MetaDataTwitter } from './types';
import SEO from '../SEO/SEO.astro';
import type { SEOProps } from '../SEO/SEO.astro';
import { adaptOpenGraphImages } from '../../utils/images';
import { buildAlternateLocales, resolvePageLocale, toOgLocale } from '../../utils/i18n';

import merge from 'lodash.merge';
import { METADATA, SITE } from 'vendor:config';

const {
  title,
  ignoreTitleTemplate = false,
  canonical: propCanonical,
  robots = {},
  description,
  openGraph = {},
  twitter = {},
  alternateUrls,
  i18n,
} = Astro.props;

// Ensure pathname has trailing slash for proper URL structure
let pathname = Astro.url.pathname;
if (!pathname.endsWith('/')) {
  pathname += '/';
}

// Get language from URL path (e.g., /ru/, /en/, /es/) — shared with Layout, so
// `og:locale` and `<html lang>` are always the same answer to the same question
const locale = resolvePageLocale(pathname, i18n);

// Merge metadata from config with props
const finalTitle = title || METADATA?.title?.default || '';

/**
 * `metadata.title.template` in the site config ("%s — Site name") frames a
 * page's own title in the browser tab, so every page does not have to repeat
 * the site name in its `title` prop. It applies only to a title the page
 * supplied: `metadata.title.default` is already written as a whole title and
 * would come out with the site name twice. A page whose title already names the
 * site — a home page, typically — opts out with `ignoreTitleTemplate`.
 *
 * Only the `<title>` tag is framed. The OpenGraph and Twitter titles below stay
 * on the bare page title, which is what a social card wants next to the site
 * name it already shows.
 */
const titleTemplate = ignoreTitleTemplate ? undefined : METADATA?.title?.template;
const documentTitle = title && titleTemplate ? titleTemplate.replace('%s', title) : finalTitle;
const finalDescription = description || METADATA?.description || '';
const finalRobots = {
  index: typeof robots?.index !== 'undefined' ? robots.index : METADATA?.robots?.index !== false,
  follow: typeof robots?.follow !== 'undefined' ? robots.follow : METADATA?.robots?.follow !== false,
};

/**
 * A page kept out of the index gets neither a canonical URL nor hreflang:
 * search engines read a canonical on a noindex page as a conflicting signal and
 * ignore hreflang on it, and a page served outside the per-locale tree (a 404,
 * say) would otherwise name its own address as every language's version. A
 * canonical passed explicitly as a prop is still written.
 */
const indexable = finalRobots.index;
const canonical = propCanonical || (indexable ? String(new URL(pathname, Astro.site)) : undefined);

// Build alternate locale links for hreflang (including self-reference)
const alternateLocales = indexable ? buildAlternateLocales(pathname, Astro.site, i18n, alternateUrls) : [];

// OpenGraph locales: the page's own, and the other languages it is listed in
const ogLocale = toOgLocale(locale, i18n?.ogLocales);
const ogLocaleAlternates = alternateLocales
  .map(({ locale: alt }) => alt)
  .filter((alt) => alt !== 'x-default' && alt !== locale)
  .map((alt) => toOgLocale(alt, i18n?.ogLocales));

// Process OpenGraph images
const mergedOpenGraph = merge({}, METADATA?.openGraph || {}, openGraph);
const processedOpenGraph = await adaptOpenGraphImages(mergedOpenGraph, Astro.site);

// Build final OpenGraph props
const ogImage = processedOpenGraph?.images?.[0]
  ? {
      url: String(new URL(processedOpenGraph.images[0].url, Astro.site)),
      width: processedOpenGraph.images[0].width,
      height: processedOpenGraph.images[0].height,
      alt: processedOpenGraph.images[0].alt,
    }
  : undefined;

const finalOpenGraph = {
  title: processedOpenGraph?.title || finalTitle,
  description: processedOpenGraph?.description || finalDescription,
  url: canonical,
  locale: ogLocale,
  localeAlternates: ogLocaleAlternates,
  type: (processedOpenGraph?.type as string) || 'website',
  image: ogImage,
  siteName: SITE?.name,
};

// Build final Twitter props.
// The config/prop shape (`cardType`, `handle`) differs from the one SEO.astro
// consumes (`card`, `creator`), so map it field by field — merging the two
// shapes silently drops every option the names disagree on.
// Card text and image default to the resolved OpenGraph values, otherwise a
// card would only ever carry `twitter:card` and nothing to render with it.
const twitterConfig: MetaDataTwitter = merge({}, METADATA?.twitter || {}, twitter || {});

const finalTwitter = {
  card: twitterConfig.cardType || (ogImage ? 'summary_large_image' : 'summary'),
  site: twitterConfig.site,
  creator: twitterConfig.handle,
  title: twitterConfig.title || finalOpenGraph.title,
  description: twitterConfig.description || finalOpenGraph.description,
  image: twitterConfig.image || ogImage?.url,
  imageAlt: twitterConfig.imageAlt || ogImage?.alt,
};

const seoProps: SEOProps = {
  title: documentTitle,
  description: finalDescription,
  canonical,
  alternateLocales,
  robots: finalRobots,
  openGraph: finalOpenGraph,
  twitter: finalTwitter as SEOProps['twitter'],
};
---

<SEO {...seoProps} />
