---
import type { WidgetNavbarProps as Props } from './types';

import { SITE } from 'vendor:config';
import { Icon } from 'astro-icon/components';
import DarkMode from '../DarkMode/DarkMode.astro';
import ToggleMenu from './ToggleMenu.astro';
import navbarBreakpoints from './breakpoints';
import Button from '../Button/Button.astro';
import WidgetWrapper from '../WidgetWrapper/WidgetWrapper.astro';
import { cn, trimSlash } from '../../utils';
import { twMerge } from 'tailwind-merge';

const {
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  showToggleTheme = false,
  initialMode = 'system',
  position = 'center',
  breakpoint = 'md',
  classes = {},
  scrollOffset = 60,
  as = 'header',
  toggleMenuLabel = 'Toggle Menu',
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const bp = navbarBreakpoints[breakpoint];

const {
  header: headerClass = '',
  container: containerClass = 'max-w-7xl 2xl:max-w-[96rem] md:mx-auto',
  links: linksClass = 'hover:text-link dark:hover:text-white',
  dropdown: dropdownClass = bp.dropdownSurface,
  dropdownLinks: dropdownLinksClass = 'hover:bg-black/10 hover:text-link dark:hover:text-white dark:hover:bg-white/10',
  megaMenu: megaMenuClass = bp.dropdownSurface,
  megaHeading: megaHeadingClass = 'text-foreground/50',
  darkModeIcon: darkModeIconClass = '',
  pinned: pinnedClasses = bp.pinned,
  unpinned: unpinnedClasses = '',
} = classes;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

/** The menu the burger button shows and hides on small screens (its `aria-controls`). */
const menuId = 'header-menu';
---

<WidgetWrapper
  id="header"
  isDark={isDark}
  bg={bg}
  as={as}
  class={cn(
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    '-top-[1px] z-40 flex-none w-full transition-[opacity] ease-in-out',
    headerClass,
    unpinnedClasses
  )}
  containerClass={twMerge('py-0 md:py-0 lg:py-0', containerClass)}
  {...isSticky ? { 'data-yt-sticky-header': true } : {}}
  data-scroll-offset={scrollOffset}
  data-fold-query={bp.foldQuery}
  data-pinned-classes={pinnedClasses}
  data-unpinned-classes={unpinnedClasses}
>
  <div class={cn('relative text-default py-3 mx-auto w-full', position === 'center' ? bp.rowCenter : bp.row)}>
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between items-center']}>
      <!-- Logo -->
      <slot name="logo">
        <span>{SITE.name || 'Logo'}</span>
      </slot>
      <div class={bp.toggle}>
        <slot name="toggle-menu">
          <ToggleMenu label={toggleMenuLabel} controls={menuId} />
        </slot>
      </div>
    </div>
    <nav id={menuId} class={bp.nav} aria-label="Main navigation">
      <ul class={bp.list}>
        {
          links.map(({ text, href, links, mega, icon }) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length && mega ? (
                <>
                  <button
                    type="button"
                    class={cn('px-4 py-3 flex items-center whitespace-nowrap cursor-pointer', linksClass)}
                  >
                    {text} <Icon name="tabler:chevron-down" class={bp.chevron} />
                  </button>
                  <div class={cn(bp.megaPanel, megaMenuClass)}>
                    <div class={bp.megaGrid} style={`--mega-cols: ${links.length}`}>
                      {links.map((column) => (
                        <div class={bp.megaColumn}>
                          {column.href ? (
                            <a
                              href={column.href}
                              class={cn(
                                'flex items-center gap-1.5 mb-2 text-xs font-semibold uppercase tracking-wider hover:text-link',
                                megaHeadingClass
                              )}
                            >
                              {column.icon && <Icon name={column.icon} class="w-4 h-4" />}
                              {column.text}
                            </a>
                          ) : (
                            <span
                              class={cn(
                                'flex items-center gap-1.5 mb-2 text-xs font-semibold uppercase tracking-wider',
                                megaHeadingClass
                              )}
                            >
                              {column.icon && <Icon name={column.icon} class="w-4 h-4" />}
                              {column.text}
                            </span>
                          )}
                          <ul class="flex flex-col">
                            {column.links?.map(({ text: text2, href: href2, icon: icon2, description }) => (
                              <li>
                                <a
                                  class={cn(bp.megaLink, { 'link-active': href2 === currentPath }, dropdownLinksClass)}
                                  href={href2}
                                >
                                  {icon2 && (
                                    <span class="flex-none mt-0.5 flex items-center justify-center w-8 h-8 rounded-md bg-foreground/[0.06] text-foreground/70 group-hover:bg-foreground/10">
                                      <Icon name={icon2} class="w-4.5 h-4.5" />
                                    </span>
                                  )}
                                  <span class="flex flex-col">
                                    <span class="font-medium leading-tight">{text2}</span>
                                    {description && (
                                      <span class="mt-0.5 text-xs font-normal text-muted-foreground leading-snug normal-case">
                                        {description}
                                      </span>
                                    )}
                                  </span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </>
              ) : links?.length ? (
                <>
                  <button
                    type="button"
                    class={cn('px-4 py-3 flex items-center whitespace-nowrap cursor-pointer', linksClass)}
                  >
                    {text} <Icon name="tabler:chevron-down" class={bp.chevron} />
                  </button>
                  <ul class={cn(bp.dropdown, dropdownClass)}>
                    {links.map(({ text: text2, href: href2 }) => (
                      <li class="px-1">
                        <a
                          class={cn(
                            'first:rounded-t last:rounded-b py-2 px-5 block whitespace-no-wrap',
                            { 'link-active': href2 === currentPath },
                            dropdownLinksClass
                          )}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class={cn([
                    'px-4 py-3 flex items-center gap-1.5 whitespace-nowrap',
                    { 'link-active': href === currentPath },
                    linksClass,
                  ])}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-4 h-4" />}
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class:list={[{ 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' }, bp.actions]} data-yt-actions>
      <div class={bp.actionsInner}>
        <div class="flex">
          {showToggleTheme && <DarkMode initialMode={initialMode} iconClass={cn(bp.darkModeIcon, darkModeIconClass)} />}
        </div>

        <!-- Actions Buttons -->
        <slot name="actions">
          {
            actions?.length ? (
              <span class="ml-4 rtl:ml-0 rtl:mr-4">
                {actions.map(({ class: actionClass, ...btnProps }) => (
                  <Button {...btnProps} class={cn(bp.action, actionClass)} />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </slot>
      </div>
    </div>
  </div>
</WidgetWrapper>

<style>
  #header.expanded nav {
    position: fixed;
    top: 100px;
    left: 0;
    right: 0;
    bottom: 70px !important;
    padding: 0 5px;
  }

  .dropdown:focus .dropdown-menu,
  .dropdown:focus-within .dropdown-menu,
  .dropdown:hover .dropdown-menu {
    display: block;
  }
</style>

<script>
  import { attachEvent, toggleClasses, addClasses, removeClasses, setMenuToggleExpanded } from '../../utils/DOMUtils';

  const addEventListeners = () => {
    const header = document.querySelector('[data-yt-sticky-header]') as HTMLElement;
    if (!header) return;

    const scrollOffset = Number(header.dataset.scrollOffset) || 0;
    const foldQuery = header.dataset.foldQuery as string;
    const pinnedClasses = header.dataset.pinnedClasses || '';
    const unpinnedClasses = header.dataset.unpinnedClasses || '';

    let lastKnownScrollPosition = window.scrollY;
    let ticking = true;

    attachEvent('[data-yt-toggle-menu]', 'click', (_: Event, elem: HTMLElement) => {
      // Batch DOM updates to prevent forced reflow
      requestAnimationFrame(() => {
        setMenuToggleExpanded(elem, !elem.classList.contains('expanded'));
        toggleClasses(document.body, 'overflow-hidden');
        toggleClasses(document.getElementById('header'), 'h-screen', 'expanded');
        toggleClasses('[data-yt-sticky-header] nav', 'hidden');
        toggleClasses('[data-yt-actions]', 'hidden');
      });
    });

    attachEvent('[data-yt-sticky-header] nav', 'click', () => {
      hiddenNav();
    });

    attachEvent([window.matchMedia(foldQuery)], 'change', () => {
      hiddenNav();
    });

    function hiddenNav() {
      // Batch DOM updates to prevent forced reflow
      requestAnimationFrame(() => {
        setMenuToggleExpanded('[data-yt-toggle-menu]', false);
        removeClasses(document.body, 'overflow-hidden');
        removeClasses(document.getElementById('header'), 'h-screen', 'expanded');
        addClasses('[data-yt-sticky-header] nav', 'hidden');
        addClasses('[data-yt-actions]', 'hidden');
      });
    }

    function applyHeaderStylesOnScroll() {
      if (lastKnownScrollPosition > scrollOffset && !header.classList.contains('scroll')) {
        addClasses(header, 'scroll', ...pinnedClasses.split(' '));
        removeClasses(header, ...unpinnedClasses.split(' '));
      } else if (lastKnownScrollPosition <= scrollOffset && header.classList.contains('scroll')) {
        removeClasses(header, 'scroll', ...pinnedClasses.split(' '));
        addClasses(header, ...unpinnedClasses.split(' '));
      }
      ticking = false;
    }
    applyHeaderStylesOnScroll();

    attachEvent([document], 'scroll', function () {
      lastKnownScrollPosition = window.scrollY;

      if (!ticking) {
        window.requestAnimationFrame(() => {
          applyHeaderStylesOnScroll();
        });
        ticking = true;
      }
    });
  };

  addEventListeners();
</script>
