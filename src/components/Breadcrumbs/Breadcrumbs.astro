---
import type { BreadcrumbsProps as Props } from './types';

import { Icon } from 'astro-icon/components';
import BreadcrumbsItem from '../BreadcrumbsItem/BreadcrumbsItem.astro';

const { class: classNames = '', ariaLabel = 'Breadcrumbs', items = [] } = Astro.props;
---

<nav class:list={['breadcrumbs', classNames]} aria-label={ariaLabel}>
  <ol class="list flex flex-wrap gap-2 m-0 p-0 list-none" itemscope itemtype="https://schema.org/BreadcrumbList">
    {items.length === 0 && <slot />}

    {
      items.map(({ icon, position, ...item }, index) => (
        <BreadcrumbsItem {...item} position={position ?? index + 1} hasIcon={!!icon}>
          {icon && (
            <Fragment slot="icon">
              <Icon name={icon} />
            </Fragment>
          )}
        </BreadcrumbsItem>
      ))
    }
  </ol>
</nav>
